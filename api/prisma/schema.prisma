generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String            @id @default(uuid())
  walletAddress    String?           @unique
  stakeKeyLovelace Float?
  jwt              String?
  createdAt        DateTime?         @default(now())
  updatedAt        DateTime?         @updatedAt
  drepRegistration DrepRegistration?
}

model Drep {
  id             String        @id @default(uuid())
  drepId         String        @unique
  name           String?
  paymentAddress String?
  iconUrl        String?
  doNotList      Boolean?
  votingPower    BigInt
  createdAt      DateTime?     @default(now())
  updatedAt      DateTime?     @updatedAt
  onchainVotes   OnchainVote[]
}

model SPO {
  id           String        @id @default(uuid())
  poolId       String        @unique
  poolName     String?
  ticker       String?
  iconUrl      String?
  votingPower  BigInt
  createdAt    DateTime?     @default(now())
  updatedAt    DateTime?     @updatedAt
  onchainVotes OnchainVote[]
}

model CC {
  id             String        @id @default(uuid())
  ccId           String        @unique
  memberName     String?
  hotCredential  String?
  coldCredential String?
  status         String?
  createdAt      DateTime?     @default(now())
  updatedAt      DateTime?     @updatedAt
  onchainVotes   OnchainVote[]
}

model SyncStatus {
  jobName        String    @id
  displayName    String?
  isRunning      Boolean   @default(false)
  startedAt      DateTime?
  completedAt    DateTime?
  lastResult     String?
  errorMessage   String?
  itemsProcessed Int?
  lockedBy       String?
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Proposal {
  id                              Int             @id @default(autoincrement())
  proposalId                      String          @unique
  txHash                          String
  certIndex                       String
  title                           String
  description                     String?
  rationale                       String?
  governanceActionType            GovernanceType?
  status                          ProposalStatus  @default(ACTIVE)
  submissionEpoch                 Int?
  ratifiedEpoch                   Int?
  enactedEpoch                    Int?
  droppedEpoch                    Int?
  expiredEpoch                    Int?
  expirationEpoch                 Int?
  drepTotalVotePower              BigInt?
  drepActiveYesVotePower          BigInt?
  drepActiveNoVotePower           BigInt?
  drepActiveAbstainVotePower      BigInt?
  drepAlwaysAbstainVotePower      BigInt?
  drepAlwaysNoConfidenceVotePower BigInt?
  drepInactiveVotePower           BigInt?
  spoTotalVotePower               BigInt?
  spoActiveYesVotePower           BigInt?
  spoActiveNoVotePower            BigInt?
  spoActiveAbstainVotePower       BigInt?
  spoAlwaysAbstainVotePower       BigInt?
  spoAlwaysNoConfidenceVotePower  BigInt?
  metadata                        String?
  createdAt                       DateTime?       @default(now())
  updatedAt                       DateTime?       @updatedAt
  onchainVotes                    OnchainVote[]

  @@unique([txHash, certIndex])
}

model OnchainVote {
  id          String    @id @default(uuid())
  txHash      String
  proposalId  String
  vote        VoteType?
  voterType   VoterType
  votingPower BigInt?
  anchorUrl   String?
  anchorHash  String?
  votedAt     DateTime? @default(now())
  createdAt   DateTime? @default(now())
  updatedAt   DateTime? @updatedAt
  drepId      String?
  spoId       String?
  ccId        String?
  cc          CC?       @relation(fields: [ccId], references: [ccId])
  drep        Drep?     @relation(fields: [drepId], references: [drepId])
  proposal    Proposal  @relation(fields: [proposalId], references: [proposalId])
  spo         SPO?      @relation(fields: [spoId], references: [poolId])

  @@unique([txHash, proposalId, voterType, drepId, spoId, ccId])
}

model NCL {
  id        String   @id @default(uuid())
  year      Int      @unique
  epoch     Int
  current   BigInt   @default(0)
  limit     BigInt
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DrepRegistration {
  id                     String                  @id @default(uuid())
  drepId                 String                  @unique
  drepName               String?
  contactEmail           String?
  userId                 String?                 @unique
  status                 RegistrationStatus      @default(PENDING)
  rationale              String?
  apiKey                 String?                 @unique
  reviewedAt             DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  discordGuildId         String?
  guilds                 DiscordGuild[]
  user                   User?                   @relation(fields: [userId], references: [id])
  notificationPreference NotificationPreference?
  verifiedDelegators     VerifiedDelegator[]

  @@index([apiKey])
  @@index([status])
  @@index([userId])
  @@index([discordGuildId])
}

model VerifiedDelegator {
  id                 String            @id @default(uuid())
  drepId             String
  discordUserId      String
  discordUsername    String
  stakeAddress       String
  liveStake          BigInt?
  isActive           Boolean           @default(true)
  deactivatedAt      DateTime?
  deactivationReason String?
  lastVerifiedAt     DateTime          @default(now())
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  reactions          DiscordReaction[]
  drepRegistration   DrepRegistration  @relation(fields: [drepId], references: [drepId])

  @@unique([drepId, discordUserId])
  @@unique([drepId, stakeAddress])
  @@index([drepId])
  @@index([discordUserId])
  @@index([isActive])
}

model DiscordGuild {
  id                  String              @id @default(uuid())
  guildId             String
  guildName           String
  drepId              String
  governanceChannelId String?
  isActive            Boolean             @default(true)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  drepRegistration    DrepRegistration    @relation(fields: [drepId], references: [drepId])
  reactions           DiscordReaction[]
  proposalPosts       GuildProposalPost[]

  @@unique([guildId, drepId])
  @@index([drepId])
}

model DiscordReaction {
  id              String            @id @default(uuid())
  proposalId      String
  drepId          String
  guildId         String
  channelId       String
  discordUserId   String
  discordUsername String
  sentiment       SentimentType
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  comment         String?
  messageId       String?
  delegator       VerifiedDelegator @relation(fields: [drepId, discordUserId], references: [drepId, discordUserId])
  guild           DiscordGuild      @relation(fields: [guildId, drepId], references: [guildId, drepId])

  @@unique([proposalId, drepId, guildId, discordUserId])
  @@index([proposalId])
  @@index([drepId])
  @@index([guildId])
}

model GuildProposalPost {
  id                String       @id @default(uuid())
  guildId           String
  drepId            String
  proposalId        String
  threadId          String
  postedAt          DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  abstainCount      Int          @default(0)
  commentCount      Int          @default(0)
  noCount           Int          @default(0)
  yesCount          Int          @default(0)
  discordNotifiedAt DateTime?
  drepRationaleUrl  String?
  drepVote          VoteType?
  drepVoteTxHash    String?
  drepVotedAt       DateTime?

  // Draft vote state (for pre-publishing vote intent before on-chain submission)
  isDraft           Boolean      @default(false) // true if this is a draft vote intent
  draftPublishedAt  DateTime?    // When the draft was published

  guild             DiscordGuild @relation(fields: [guildId, drepId], references: [guildId, drepId])

  @@unique([guildId, drepId, proposalId])
  @@unique([proposalId, drepId])
  @@index([proposalId])
  @@index([threadId])
  @@index([drepId])
  @@index([isDraft])
}

model NotificationPreference {
  id                    String           @id @default(uuid())
  drepId                String           @unique
  discordUserId         String?
  discordChannelEnabled Boolean          @default(true)
  discordDmEnabled      Boolean          @default(false)
  alertDays             Int[]            @default([7, 3, 1])
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  inAppToastEnabled     Boolean          @default(true)
  drepRegistration      DrepRegistration @relation(fields: [drepId], references: [drepId])

  @@index([discordUserId])
  @@index([inAppToastEnabled])
}

model DeadlineAlert {
  id               String             @id @default(uuid())
  proposalId       String
  drepId           String
  recipientType    AlertRecipientType
  recipientId      String
  alertChannel     AlertChannel
  daysBeforeExpiry Int
  drepHasVoted     Boolean            @default(false)
  sentAt           DateTime?
  deliveryStatus   DeliveryStatus     @default(PENDING)
  errorMessage     String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  drepVote         VoteType?

  @@unique([proposalId, drepId, recipientType, recipientId, alertChannel, daysBeforeExpiry])
  @@index([proposalId])
  @@index([drepId])
  @@index([deliveryStatus])
  @@index([createdAt])
}

enum VoteType {
  YES
  NO
  ABSTAIN
}

enum VoterType {
  DREP
  SPO
  CC
}

enum GovernanceType {
  INFO_ACTION
  TREASURY_WITHDRAWALS
  NEW_CONSTITUTION
  HARD_FORK_INITIATION
  PROTOCOL_PARAMETER_CHANGE
  NO_CONFIDENCE
  UPDATE_COMMITTEE
}

enum ProposalStatus {
  ACTIVE
  RATIFIED
  ENACTED
  EXPIRED
  CLOSED
}

enum SentimentType {
  YES
  NO
  ABSTAIN
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AlertRecipientType {
  DREP
  DELEGATOR
}

enum AlertChannel {
  DISCORD_CHANNEL
  DISCORD_DM
  IN_APP_TOAST
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
}
